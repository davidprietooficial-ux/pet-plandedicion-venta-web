# ══════════════════════════════════════════════════════════════════════
#  .htaccess — Hostinger / Apache / LiteSpeed
#
#  Vite copia esto de public/ a dist/ tal cual. Comprobar antes de subir:
#    test -f sitio/dist/.htaccess
#
#  Cabeceras de seguridad: CSP con frame-src limitado al checkout de
#  Hotmart, Permissions-Policy con payment habilitado solo para
#  pay.hotmart.com, Trusted Types para los scripts de analítica.
#
#  Lo que NO hace: mitigar denegación de servicio. Eso no se resuelve
#  desde un hosting compartido — hace falta Cloudflare delante del
#  dominio.
# ══════════════════════════════════════════════════════════════════════

# ── HTTPS obligatorio ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Sin www. Elige UNA versión canónica: tener las dos parte el SEO.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # URLs limpias: /contacto serviría contacto.html sin mostrar la extensión,
  # si algún día hubiera una página así. Las rutas legales ya son carpetas
  # con index.html (Apache las sirve solas); esta regla queda inerte hasta
  # que haga falta.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── Cabeceras de seguridad ───────────────────────────────────────────
<IfModule mod_headers.c>

  # HSTS: un año, subdominios incluidos.
  # OJO: no activar hasta que el certificado funcione. Una vez que el
  # navegador lo recuerda, no hay forma de volver a http durante ese año.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # payment solo habilitado para el checkout embebido de Hotmart.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://pay.hotmart.com\"), usb=(), interest-cohort=()"

  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # ── CSP ────────────────────────────────────────────────────────────
  # frame-src limitado al checkout de Hotmart (iframe [data-checkout-frame]).
  # require-trusted-types-for + trusted-types scripts-analitica: cualquier
  # <script>.src pasa por la política nombrada en src/lib/tracking.ts o el
  # navegador la bloquea — ver ese archivo para la lista blanca de dominios.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src https://*.hotmart.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'; trusted-types scripts-analitica; upgrade-insecure-requests"

  # Se quita la firma del servidor: menos información gratis para quien
  # esté buscando versiones con vulnerabilidades conocidas.
  Header always unset X-Powered-By
  Header always unset Server
  Header always unset X-Pingback

  # Caché: los assets llevan hash en el nombre, así que un año es seguro.
  # El HTML nunca se cachea, o quien visite no ve los cambios (precio,
  # ventana de la oferta).
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|jpeg|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compresión ───────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Tipos MIME que Hostinger no siempre trae ─────────────────────────
<IfModule mod_mime.c>
  AddType image/avif                   .avif
  AddType image/webp                   .webp
  AddType font/woff2                   .woff2
  AddType application/manifest+json    .webmanifest
</IfModule>

# ── Lo que no se sirve ───────────────────────────────────────────────

# Sin listados de directorio. Sin esto, cualquiera navega la estructura.
Options -Indexes

# Archivos que nunca deben ser públicos. Comprobar después de subir:
#   curl -s -o /dev/null -w "%{http_code}\n" https://TU-DOMINIO/.env
# Tiene que dar 403 o 404. Si da 200, este bloque no se está aplicando.
<FilesMatch "(^\.|\.(env|map|json|lock|md|log|sql|bak|old|orig|swp|dist|ini|yml|yaml)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Excepciones: estos SÍ son públicos y tienen que servirse.
<FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest|manifest\.json)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# Carpetas de control de versiones y dependencias — no existen en dist/,
# pero por si alguna vez se sube el repo entero por error.
RedirectMatch 404 /\.git
RedirectMatch 404 /node_modules
RedirectMatch 404 /\.well-known/(?!acme-challenge|security\.txt)

# ── Higiene ──────────────────────────────────────────────────────────
# No es defensa contra denegación de servicio (eso es Cloudflare, ver
# blindar.md paso 6), pero quita ruido y cierra métodos que este sitio
# no usa.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT|PATCH|PUT|DELETE)$
  RewriteRule .* - [F,L]
</IfModule>

LimitRequestBody 2097152
